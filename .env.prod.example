# Copy to .env.prod on the server and fill in. Never commit .env.prod.

# Public hostname. Without your own domain, use the server IP via sslip.io,
# e.g. 203.0.113.7 -> 203-0-113-7.sslip.io
DOMAIN=203-0-113-7.sslip.io

# Database. Use only letters and digits in the password (it goes into a URL):
#   openssl rand -hex 24
POSTGRES_USER=groovelog
POSTGRES_DB=groovelog
POSTGRES_PASSWORD=

# JWT signing keys. Generate each with: openssl rand -hex 32
JWT_ACCESS_KEY=
JWT_REFRESH_KEY=

# Gunicorn workers (2 is plenty for a small server)
WEB_CONCURRENCY=2
